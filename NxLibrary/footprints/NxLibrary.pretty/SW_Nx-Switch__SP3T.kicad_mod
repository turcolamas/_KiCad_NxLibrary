  )
  (fp_line (start -1 -2) (end 11.8 -2) (layer F.Fab) (width 0.1))
  (fp_line (start 14.25 -2) (end 14.25 4.5) (layer F.Fab) (width 0.1))
  (fp_line (start 12 4.5) (end -2.9 4.5) (layer F.Fab) (width 0.1))
  (fp_line (start -2.9 4.5) (end -2.9 -1) (layer F.Fab) (width 0.1))
  (fp_line (start 14.25 -1.35) (end 14.25 3.85) (layer F.SilkS) (width 0.12))
  (fp_line (start -3 3.85) (end -3 -1.35) (layer F.SilkS) (width 0.12))
  (fp_line (start -0.95 -2.1) (end 12 -2.1) (layer F.SilkS) (width 0.12))
  (fp_line (start 12 4.6) (end -0.95 4.6) (layer F.SilkS) (width 0.12))
  (fp_line (start -3.25 -3) (end 14.5 -3) (layer F.CrtYd) (width 0.05))
  (fp_line (start 14.5 -3) (end 14.5 5.5) (layer F.CrtYd) (width 0.05))
  (fp_line (start 14.5 5.5) (end -3.25 5.5) (layer F.CrtYd) (width 0.05))
  (fp_line (start -3.25 5.5) (end -3.25 -3) (layer F.CrtYd) (width 0.05))
  (fp_line (start -1.9 -2) (end -2.9 -1) (layer F.Fab) (width 0.1))
  (fp_line (start -3.3 -1.75) (end -3.3 -3.05) (layer F.SilkS) (width 0.12))
  (fp_line (start -3.3 -3.05) (end -2 -3.05) (layer F.SilkS) (width 0.12))
  (fp_text user %R (at 4.75 2.5 -180) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.1)))
  )
  (pad "" thru_hole circle (at -2 -1.75) (size 2.5 2.5) (drill 1.2) (layers *.Cu *.Mask))
  (pad "" thru_hole circle (at 13.1064 -1.7272) (size 2.5 2.5) (drill 1.2) (layers *.Cu *.Mask))
  (pad "" thru_hole circle (at 13.1064 4.5212) (size 2.5 2.5) (drill 1.2) (layers *.Cu *.Mask))
