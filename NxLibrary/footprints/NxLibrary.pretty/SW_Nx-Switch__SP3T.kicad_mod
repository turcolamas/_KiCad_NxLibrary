  (pad 2 thru_hole oval (at 3.5 0.0508) (size 1.5 2) (drill 0.9) (layers *.Cu *.Mask))
  (pad 3 thru_hole oval (at 5.5 0) (size 1.5 2) (drill 0.9) (layers *.Cu *.Mask))
  (pad 4 thru_hole oval (at 9.5 0) (size 1.5 2) (drill 0.9) (layers *.Cu *.Mask))
  (model ${KISYS3DMOD}/Button_Switch_THT.3dshapes/SW_E-Switch_EG2219_DPDT_Angled.wrl
